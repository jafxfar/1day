{
  "compilerOptions": {
    "target":                 "ES2022",
    "module":                 "CommonJS",
    "lib":                    ["ES2022"],
    "outDir":                 "./dist",
    "rootDir":                "./src",
    "strict":                 true,
    "esModuleInterop":        true,
    "skipLibCheck":           true,
    "resolveJsonModule":      true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false,
    "types":                  ["node"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist", "resources"]
}
